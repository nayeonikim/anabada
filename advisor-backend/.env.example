# ── Advisor Backend (U1) 환경설정 예시 ──
# 값을 조정한 뒤 `.env`로 복사하여 사용. 코드 수정 없이 동작 변경(NFR-S4/M3).

# Classification thresholds (제약: 0 < EXTEND_THRESHOLD <= REUSE_THRESHOLD <= 1)
REUSE_THRESHOLD=0.75
EXTEND_THRESHOLD=0.50

# 재검증 대상 Top-N (A-3: N=3)
TOP_N=3

# Demo mode: true=결정적 fixture(대표 시나리오), false=실제 Bedrock 호출
DEMO_MODE=true

# LLM (Amazon Bedrock Claude)
LLM_MODEL_ID=anthropic.claude-3-5-sonnet-20241022-v2:0
LLM_REGION=us-east-1
LLM_TIMEOUT_SECONDS=30

# 데이터/피드백 경로 (advisor-backend/ 기준 상대 또는 절대)
ASSETS_PATH=data/assets.json
EVIDENCE_PATH=data/evidence.json
DEMO_FIXTURES_PATH=data/demo_fixtures.json
FEEDBACK_PATH=data/feedback.jsonl

# 로깅
LOG_LEVEL=INFO
